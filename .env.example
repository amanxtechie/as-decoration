# AS Decoration — Environment Configuration
# Copy this file to ".env" and fill in real values.
# On Render, set these in the dashboard (or use render.yaml) — no .env file is committed.

# ---- Server ----
# Port the Express service listens on. Render sets this automatically; ignore it locally.
PORT=5000
# Origins allowed by CORS, comma separated.
# In production the site and API share one origin, so this can stay as-is.
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ---- Database ----
# PostgreSQL connection string.
# Local:  postgresql://localhost:5432/asdecoration
# Neon:   postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/asdecoration?sslmode=require
DATABASE_URL=postgresql://localhost:5432/asdecoration
# Max pooled connections (keep low on free tiers)
DB_POOL_MAX=5

# ---- Auth / Security ----
# Long random string. Generate with:  openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=12h

# ---- Admin bootstrap (used only by the seed script) ----
ADMIN_EMAIL=admin@asdecoration.com
ADMIN_PASSWORD=ChangeMe123!
# WARNING: change this password immediately after first login, in Admin > Profile.

# ---- File uploads ----
# Max upload size in bytes (8 MB)
MAX_UPLOAD_SIZE=8388608
# Comma-separated allowed image mime types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ---- Business info ----
# Country code + number, no + or spaces. Used for every WhatsApp link and schema.org.
WHATSAPP_NUMBER=917667999217
BUSINESS_NAME=AS Decoration
